<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Macronutrienții - NutriTECH</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <style>
    p {
      color: #ffffff !important;
    }
    .quiz-option {
      transition: all 0.3s ease;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--glass-border);
      color: #ffffff !important;
      text-align: left;
    }
    .quiz-option:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateX(5px);
    }
    .quiz-option.correct-choice {
      border: 2px solid #10b981 !important;
      background: rgba(16, 185, 129, 0.1) !important;
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
      color: #10b981 !important;
      font-weight: bold;
    }
    .quiz-option.incorrect-choice {
      border: 2px solid #ef4444 !important;
      background: rgba(239, 68, 68, 0.1) !important;
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
      color: #ef4444 !important;
      font-weight: bold;
    }
  </style>
</head>
<body>

  <!-- Background Decorative Glowing Elements -->
  <div class="glow-container">
    <div class="glow-bg glow-primary"></div>
    <div class="glow-bg glow-secondary"></div>
    <div class="glow-bg glow-third"></div>
  </div>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-custom navbar-dark">
    <div class="container">
      <a class="navbar-brand navbar-brand-custom" href="/">
        <i class="bi bi-heart-pulse-fill text-success"></i> Nutri<span>TECH</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/"><i class="bi bi-house-door-fill me-1"></i> Acasă</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/dashboard"><i class="bi bi-grid-1x2-fill me-1"></i> Dashboard</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/academy"><i class="bi bi-book-half me-1"></i> Academie</a>
          </li>
          <li class="nav-item">
            <a class="nav-link nav-link-custom" href="/quiz"><i class="bi bi-patch-question-fill me-1"></i> Quiz</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Content Container -->
  <div class="container py-5" style="margin-top: 40px;">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">
        <div class="glass-card text-center mb-4">
          <!-- Icon & Header -->
          <div class="feature-icon mb-4" style="background: rgba(6, 182, 212, 0.1); border-color: rgba(6, 182, 212, 0.2); color: var(--color-secondary);">
            <i class="bi bi-egg-fried"></i>
          </div>
          <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill mb-3 border border-info border-opacity-25 fw-bold">PILONUL 2: CĂRĂMIZILE NUTRIȚIONALE</span>
          <h1 class="display-5 font-title fw-bold mb-4"><span class="gradient-text">Macronutrienții</span></h1>
          
          <!-- Detailed content -->
          <div class="text-start text-bright mt-4" style="line-height: 1.8;">
            <p class="lead mb-4" style="font-size: 1.15rem; color: #a5f3fc !important;">
              Macronutrienții sunt compuși chimici pe care organismul îi cere în cantități mari (zilnic, ordinul zecilor sau sutelor de grame) pentru a produce energie, a reface structurile celulare și a secreta enzime. Aceștia sunt: Proteinele, Carbohidrații și Grăsimile.
            </p>
            
            <div class="row g-3 mb-4">
              <!-- Proteine -->
              <div class="col-12">
                <div class="p-3 rounded" style="background: rgba(16, 185, 129, 0.03); border: 1px solid rgba(16, 185, 129, 0.15);">
                  <h5 class="font-title text-success mb-2"><i class="bi bi-shield-fill me-2"></i> Proteinele (4 kcal/g): Aminoacizi & Regenerare</h5>
                  <p class="mb-2">
                    Proteinele sunt formate din lanțuri complexe de molecule mai mici numite aminoacizi. Există 20 de aminoacizi proteogeni primari: 11 sunt neesențiali (corpul îi poate secreta singur), în timp ce <strong>9 sunt esențiali</strong> (nu pot fi sintetizați de organism și trebuie neapărat consumați prin hrană).
                  </p>
                  <p class="mb-0 small">
                    Ele au o funcție structurală majoră (construiesc mușchii, pielea, organele, anticorpii și enzimele). De asemenea, consumul adecvat de proteine (1.6 - 2.0g per kg corp) generează o sațietate extrem de mare, stimulând eliberarea de hormoni ai sațietății (cum ar fi PYY și GLP-1) și păstrând masa musculară intactă în timpul unui deficit caloric.
                  </p>
                </div>
              </div>

              <!-- Carbohidrați -->
              <div class="col-12">
                <div class="p-3 rounded" style="background: rgba(6, 182, 212, 0.03); border: 1px solid rgba(6, 182, 212, 0.15);">
                  <h5 class="font-title text-secondary mb-2"><i class="bi bi-fire me-2"></i> Carbohidrații (4 kcal/g): Energie rapidă & Glicogen</h5>
                  <p class="mb-2">
                    Carbohidrații reprezintă principala sursă energetică a organismului. Ei sunt descompuși în glucoză (zahărul din sânge), folosită direct de celule. Surplusul de glucoză este transformat de insulină în <strong>glicogen, stocat în principal în mușchi (~400g) și ficat (~100g)</strong> ca rezervă rapidă de energie.
                  </p>
                  <p class="mb-0 small">
                    Carbohidrații complecși (polizaharide precum ovăzul, orezul brun, cartoful dulce) sunt absorbiți lent și oferă energie constantă. Carbohidrații simpli (monozaharide ca zahărul rafinat sau sucurile îndulcite) cresc glicemia brusc, stimulând secreția masivă de insulină, urmată de o scădere rapidă a energiei și reapariția senzației de foame.
                  </p>
                </div>
              </div>

              <!-- Grăsimi -->
              <div class="col-12">
                <div class="p-3 rounded" style="background: rgba(99, 102, 241, 0.03); border: 1px solid rgba(99, 102, 241, 0.15);">
                  <h5 class="font-title text-accent mb-2" style="color: #818cf8 !important;"><i class="bi bi-droplet-half me-2"></i> Grăsimile (9 kcal/g): Sănătate hormonală & Celulară</h5>
                  <p class="mb-2">
                    Deși au densitatea energetică cea mai mare (9 kcal pe gram), grăsimile alimentare sunt cruciale pentru viață. Creierul uman este compus în proporție de ~60% din grăsimi (în principal teaca de mielină care izolează neuronii), iar fiecare membrană celulară conține un dublu strat fosfolipidic.
                  </p>
                  <p class="mb-0 small">
                    Grăsimile sunt esențiale pentru absorbția vitaminelor liposolubile (A, D, E, K) și servesc ca precursor chimic direct în sinteza hormonilor steroizi (cum ar fi testosteronul și estrogenul). Trebuie să punem accentul pe grăsimi nesaturate (ulei de măsline, avocado, nuci, migdale, acizi grași Omega-3 din pește gras) și să limităm grăsimile trans/saturate procesate industrial.
                  </p>
                </div>
              </div>
            </div>

            <div class="info-explain mt-4 mb-4">
              <h5 class="font-title mb-2 text-secondary" style="font-size: 1.1rem;"><i class="bi bg-opacity-10 me-2"></i> Concluzie:</h5>
              <p class="mb-0" style="color: #a5f3fc !important;">
                Pentru performanțe metabolice ideale, nu te uita doar la calorii. O dietă echilibrată metabolic conține o cantitate optimă de proteine (pentru reconstrucție), grăsimi sănătoase (pentru echilibrul hormonal) și carbohidrați complecși (pentru susținerea efortului fizic și cerebral zilnic).
              </p>
            </div>
          </div>

          <!-- Quiz Section -->
          <hr class="my-5" style="border-color: var(--glass-border);">
          <div class="quiz-container text-start p-4 rounded mb-5" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--glass-border);">
            <h3 class="font-title text-info mb-2"><i class="bi bi-patch-question-fill me-2"></i> Chestionar rapid: Testează-ți cunoștințele</h3>
            <p class="text-muted small mb-4 quiz-subtitle">Răspunde la 3 întrebări rapide din textul de mai sus pentru a-ți valida atenția!</p>
            
            <div id="quiz-box">
              <!-- Întrebarea 1 -->
              <div class="question-step" id="q-step-1">
                <h5 class="mb-3 text-bright">Întrebarea 1: Câte calorii (kcal) furnizează un singur gram de grăsimi?</h5>
                <div class="d-flex flex-column gap-2">
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="false">A) 4 kcal</button>
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="false">B) 7 kcal</button>
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="true">C) 9 kcal</button>
                </div>
              </div>

              <!-- Întrebarea 2 -->
              <div class="question-step d-none" id="q-step-2">
                <h5 class="mb-3 text-bright">Întrebarea 2: Câți aminoacizi esențiali există (pe care organismul nu îi poate produce singur și trebuie neapărat obținuți din alimentație)?</h5>
                <div class="d-flex flex-column gap-2">
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="true">A) 9 aminoacizi</button>
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="false">B) 12 aminoacizi</button>
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="false">C) 20 aminoacizi</button>
                </div>
              </div>

              <!-- Întrebarea 3 -->
              <div class="question-step d-none" id="q-step-3">
                <h5 class="mb-3 text-bright">Întrebarea 3: Unde este stocat în principal glicogenul (forma de stocare a carbohidraților) în organismul nostru?</h5>
                <div class="d-flex flex-column gap-2">
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="false">A) În creier și stomac</button>
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="true">B) În mușchi și ficat</button>
                  <button class="btn quiz-option py-2 px-3 w-100" data-correct="false">C) În rinichi și țesutul adipos</button>
                </div>
              </div>
            </div>

            <!-- Ecran de Rezultat -->
            <div id="quiz-result" class="text-center d-none py-4">
              <h4 class="font-title text-info mb-2"><i class="bi bi-trophy-fill me-2"></i> Chestionar Finalizat!</h4>
              <p class="lead text-bright my-3" id="quiz-score-text">Ai răspuns corect la 0 din 3 întrebări.</p>
              <div class="progress mb-4" style="height: 10px; background: rgba(255,255,255,0.05); border-radius: 5px;">
                <div class="progress-bar bg-info" id="quiz-progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <button class="btn btn-primary-custom" id="btn-restart-quiz"><i class="bi bi-arrow-clockwise me-2"></i> Reîncepe Chestionarul</button>
            </div>
          </div>

          <!-- Back Button -->
          <div class="mt-5 d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-outline-custom btn-lg"><i class="bi bi-arrow-left me-2"></i> Înapoi la Acasă</a>
            <a href="/academy" class="btn btn-primary-custom btn-lg"><i class="bi bi-book me-2"></i> Mergi la Academie</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="text-center text-muted mt-5">
    <div class="footer-container">
      <p class="mb-0">&copy; 2026 NutriTECH. Dezvoltat ca software educațional și asistent personal de nutriție.</p>
    </div>
  </footer>

  <!-- jQuery & Quiz Engine Script -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    $(document).ready(function() {
      let currentStep = 1;
      let correctAnswers = 0;
      let canAnswer = true;

      // Click option logic
      $('.quiz-option').on('click', function() {
        if (!canAnswer) return;
        canAnswer = false;

        const isCorrect = $(this).attr('data-correct') === 'true';
        const currentQuestionBox = $(this).closest('.question-step');

        if (isCorrect) {
          $(this).addClass('correct-choice');
          correctAnswers++;
        } else {
          $(this).addClass('incorrect-choice');
          // Highlight the correct option in green as feedback
          currentQuestionBox.find('[data-correct="true"]').addClass('correct-choice');
        }

        // Delay before moving to the next step
        setTimeout(function() {
          currentQuestionBox.addClass('d-none');
          currentStep++;

          if (currentStep <= 3) {
            $(`#q-step-${currentStep}`).removeClass('d-none');
            canAnswer = true;
          } else {
            // End of Quiz
            $('#quiz-box').addClass('d-none');
            $('#quiz-result').removeClass('d-none');
            
            // Set text & score bar
            $('#quiz-score-text').text(`Ai răspuns corect la ${correctAnswers} din 3 întrebări.`);
            const percentage = (correctAnswers / 3) * 100;
            $('#quiz-progress-bar').css('width', `${percentage}%`).attr('aria-valuenow', percentage);
          }
        }, 1500);
      });

      // Restart Quiz logic
      $('#btn-restart-quiz').on('click', function() {
        currentStep = 1;
        correctAnswers = 0;
        canAnswer = true;

        // Reset classes
        $('.quiz-option').removeClass('correct-choice incorrect-choice');
        
        // Show box and first step, hide results
        $('#quiz-box').removeClass('d-none');
        $('.question-step').addClass('d-none');
        $('#q-step-1').removeClass('d-none');
        $('#quiz-result').addClass('d-none');
      });
    });
  </script>
</body>
</html>
